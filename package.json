{
  "name": "permission-system",
  "version": "1.0.2",
  "description": "Pi data-ops permission gate and automatic review with a session-only manual mode",
  "keywords": ["pi-package", "pi-extension", "permissions"],
  "type": "module",
  "engines": { "node": ">=24" },
  "files": ["index.mjs", "dist"],
  "pi": { "extensions": ["./index.mjs"] },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/package.test.mjs"
  },
  "dependencies": {
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.26.13",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@gotgenes/pi-permission-system": "42.1.0",
    "@mzwing/pi-permission-auto-review": "1.0.2",
    "esbuild": "0.28.2"
  }
}
